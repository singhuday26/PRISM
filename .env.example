MONGO_URI=mongodb://localhost:27017
DB_NAME=prism_db
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Risk Computation Settings
RISK_HIGH_THRESHOLD=0.7

# Database Connection Settings
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# CORS Configuration
ENABLE_CORS=true
# Comma-separated list of allowed origins, or "*" for all
# Example for production: CORS_ORIGINS=https://your-app.up.railway.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Dashboard/Frontend Configuration
API_URL=http://localhost:8000

# ── Production / PaaS Variables ─────────────────────────────────────────────
# IMPORTANT: Free-tier hosts (Koyeb, HuggingFace Spaces, Render free) have
# EPHEMERAL filesystems — all container data is wiped on every deploy.
# You MUST point DATABASE_URL at an external hosted database (e.g. MongoDB
# Atlas free tier) to make your data persist across deploys.
#
# How to set up MongoDB Atlas (free, permanent):
#   1. Sign up at https://cloud.mongodb.com
#   2. Create a free M0 cluster
#   3. Create a database user and allow connections from 0.0.0.0/0
#   4. Copy the connection string and set it as DATABASE_URL below
#      (format: mongodb+srv://user:pass@cluster.mongodb.net/prism_db)
#
# DATABASE_URL takes priority over MONGO_URI in the backend and seed scripts.
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/prism_db

# Set by Railway for every deployed service. Used by the backend to
# automatically add the production origin to the CORS allow-list.
# RAILWAY_PUBLIC_DOMAIN=your-service.up.railway.app
